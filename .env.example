# Copy to .env. Never commit secrets.

APP_NAME=RainMumbai AI
ENV=development
# Set this to a strong random value before deployment.
SECRET_KEY=replace-with-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_REMEMBER_MINUTES=10080

# Local default (SQLite). Set a full PostgreSQL URL to use PostgreSQL instead.
DATABASE_URL=sqlite:///./rainmumbai.db
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/rainmumbai

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Mumbai display coordinates (dashboard badge). Index uses Colaba + Santacruz.
MUMBAI_LAT=19.0760
MUMBAI_LON=72.8777
COLABA_LAT=18.9067
COLABA_LON=72.8147
SANTACRUZ_LAT=19.0896
SANTACRUZ_LON=72.8656

OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ENSEMBLE_URL=https://ensemble-api.open-meteo.com/v1/ensemble
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_HISTORICAL_FORECAST_URL=https://historical-forecast-api.open-meteo.com/v1/forecast
OPEN_METEO_TIMEOUT_SECONDS=20

INDEX_CONFIG_PATH=config/index.yaml
DISCLAIMER=Predictions are probabilistic and based on historical data and current meteorological conditions. They do not guarantee future outcomes.

SMTP_ENABLED=false
RESET_TOKEN_EXPIRE_MINUTES=30

SCHEDULER_ENABLED=true
HOURLY_INGEST_CRON=0 * * * *
MONTHLY_EVAL_CRON=0 3 1 * *

# Seeded admin account (change before production!)
ADMIN_EMAIL=admin@rainmumbai.ai
ADMIN_PASSWORD=replace-with-strong-password

# Days of historical rainfall to backfill for the current index (season lookback).
SEASON_BACKFILL_DAYS=220

# Used to build password-reset links in emails.
FRONTEND_URL=http://localhost:5173
